---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
const en = t('en');
const az = t('az');
---

<Base lang="en" title={`${en.notFound.title} | Meridel Advisory`} description={en.notFound.text} path="/" hasAlternate={false}>
  <section class="section">
    <div class="wrap nf">
      <h1>{en.notFound.title}</h1>
      <p>{en.notFound.text} <a href="/">{en.notFound.home}</a></p>
      <p lang="az">{az.notFound.text} <a href="/az">{az.notFound.home}</a></p>
    </div>
  </section>
</Base>

<style>
  .nf h1 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }
  .nf p {
    color: var(--slate);
  }
</style>

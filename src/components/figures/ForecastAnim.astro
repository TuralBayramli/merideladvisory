---
// Forecast accuracy, animated: forecast and actual demand month by month,
// the error above each month, then MAPE, WAPE and bias for the six months.
import type { Lang } from '../../i18n/ui';
import { x } from '../../i18n/extra';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = x(lang).figs.forecast;
const forecast = [100, 110, 105, 120, 115, 125];
const actual = [92, 118, 98, 130, 104, 121];
const err = forecast.map((f, i) => f - actual[i]);
const sumA = actual.reduce((a, b) => a + b, 0);
const mape = (err.reduce((s, e, i) => s + Math.abs(e) / actual[i], 0) / err.length) * 100;
const wape = (err.reduce((s, e) => s + Math.abs(e), 0) / sumA) * 100;
const bias = (err.reduce((s, e) => s + e, 0) / sumA) * 100;
const pct = (n: number, sign = false) =>
  `${sign && n > 0 ? '+' : n < 0 ? '−' : ''}${Math.abs(n).toFixed(1).replace('.', lang === 'az' ? ',' : '.')}%`;
const signed = (n: number) => (n > 0 ? `+${n}` : n < 0 ? `−${-n}` : '0');
const MAX = 140;
---

<div class="fc">
  <div class="chart" aria-hidden="true">
    {
      L.months.map((m, i) => (
        <div class="month" style={`--d:${(0.2 + i * 0.45).toFixed(2)}s`}>
          <span class:list={['err', err[i] > 0 ? 'hi' : 'lo']}>{signed(err[i])}</span>
          <div class="pair">
            <span class="b f" style={`--h:${forecast[i] / MAX}`} />
            <span class="b a" style={`--h:${actual[i] / MAX}`} />
          </div>
          <span class="m">{m}</span>
        </div>
      ))
    }
  </div>
  <ul class="key" aria-hidden="true">
    <li><span class="k-f"></span>{L.forecast}</li>
    <li><span class="k-a"></span>{L.actual}</li>
  </ul>
  <dl class="stats">
    <div>
      <dt>MAPE</dt>
      <dd>{pct(mape)}</dd>
    </div>
    <div>
      <dt>WAPE</dt>
      <dd>{pct(wape)}</dd>
    </div>
    <div>
      <dt>{L.bias}</dt>
      <dd>
        {pct(bias, true)} <small>{L.over}</small>
      </dd>
    </div>
  </dl>
  <p class="note">{L.note}</p>
</div>

<style>
  .chart {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.75rem;
    align-items: end;
    height: 13rem;
    padding-bottom: 0.25rem;
    border-bottom: 1.5px solid var(--ink);
  }
  .month {
    display: grid;
    grid-template-rows: auto 1fr auto;
    height: 100%;
    justify-items: center;
    gap: 0.3rem;
  }
  .err {
    font-size: 0.8rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .err.hi {
    color: var(--gold-ink);
  }
  .err.lo {
    color: var(--signal);
  }
  .pair {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    width: 100%;
    max-width: 4.2rem;
    height: 100%;
  }
  .b {
    flex: 1;
    height: calc(var(--h) * 100%);
    border-radius: 3px 3px 0 0;
    transform-origin: bottom center;
  }
  .f {
    background: transparent;
    border: 1.5px dashed var(--muted);
    border-bottom: 0;
  }
  .a {
    background: var(--signal);
  }
  .m {
    font-size: 0.8rem;
    color: var(--muted);
    transform: translateY(1.6rem);
    height: 0;
  }
  .key {
    list-style: none;
    margin: 2.75rem 0 0;
    padding: 0;
    display: flex;
    gap: 1.25rem;
    font-size: 0.825rem;
    color: var(--ink-2);
  }
  .key li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .key span {
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 2px;
  }
  .k-f {
    border: 1.5px dashed var(--muted);
  }
  .k-a {
    background: var(--signal);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin: 1.25rem 0 0;
  }
  .stats div {
    padding: 0.75rem 0.9rem;
    border-radius: 10px;
    background: var(--mist);
  }
  .stats dt {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
  }
  .stats dd {
    margin: 0.2rem 0 0;
    font: 400 1.5rem / 1.15 var(--serif);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .stats small {
    display: block;
    font: 400 0.75rem / 1.3 var(--sans);
    color: var(--muted);
  }
  .note {
    margin: 0.9rem 0 0;
    font-size: 0.825rem;
    color: var(--muted);
  }
  @media (max-width: 34rem) {
    .chart {
      gap: 0.35rem;
      height: 11rem;
    }
    .stats {
      grid-template-columns: 1fr 1fr;
    }
    .stats div:last-child {
      grid-column: 1 / -1;
    }
  }

  :global(.is-ready) .b {
    transform: scaleY(0);
  }
  :global(.is-ready) .err,
  :global(.is-ready) .stats div {
    opacity: 0;
  }
  :global(.is-on) .b {
    animation: fc-grow 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d) both;
  }
  :global(.is-on) .a {
    animation-delay: calc(var(--d) + 0.15s);
  }
  :global(.is-on) .err {
    animation: fc-fade 0.35s ease calc(var(--d) + 0.6s) both;
  }
  :global(.is-on) .stats div {
    animation: fc-fade 0.5s ease 3.3s both;
  }
  :global(.is-on) .stats div:nth-child(2) {
    animation-delay: 3.5s;
  }
  :global(.is-on) .stats div:nth-child(3) {
    animation-delay: 3.7s;
  }
  @keyframes fc-grow {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }
  @keyframes fc-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

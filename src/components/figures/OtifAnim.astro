---
// OTIF, animated: from all orders to those on time, in full, and both.
import type { Lang } from '../../i18n/ui';
import { x } from '../../i18n/extra';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const L = x(lang).figs.otif;
const values = [1000, 920, 900, 850];
const fmt = (n: number) => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, lang === 'az' ? ' ' : ',');
---

<div class="otif">
  <ul class="rows">
    {
      L.rows.map((label, i) => (
        <li class:list={['row', { last: i === values.length - 1 }]} style={`--s:${values[i] / 1000};--d:${(0.2 + i * 0.7).toFixed(2)}s`}>
          <span class="label">{label}</span>
          <span class="track">
            <span class="bar" />
          </span>
          <span class="val">
            <b>{fmt(values[i])}</b> {Math.round(values[i] / 10)}%
          </span>
        </li>
      ))
    }
  </ul>
  <p class="note">{L.note}</p>
</div>

<style>
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(8rem, 13rem) 1fr 6.5rem;
    align-items: center;
    gap: 0.9rem;
  }
  .label {
    font-size: 0.925rem;
    color: var(--ink-2);
  }
  .last .label {
    font-weight: 600;
    color: var(--ink);
  }
  .track {
    position: relative;
    height: 1.6rem;
    border-radius: 4px;
    background: var(--mist);
  }
  .bar {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    background: var(--signal-mid);
    transform-origin: left center;
    transform: scaleX(var(--s));
  }
  .last .bar {
    background: var(--signal);
  }
  .val {
    font-size: 0.85rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .val b {
    color: var(--ink);
    font-size: 0.95rem;
    margin-right: 0.2rem;
  }
  .note {
    margin: 1.25rem 0 0;
    font-size: 0.825rem;
    color: var(--muted);
  }
  @media (max-width: 34rem) {
    .row {
      grid-template-columns: 1fr 5.5rem;
      gap: 0.35rem 0.75rem;
    }
    .label {
      grid-column: 1 / -1;
    }
  }

  :global(.is-ready) .bar {
    transform: scaleX(0);
  }
  :global(.is-ready) .val {
    opacity: 0;
  }
  :global(.is-on) .bar {
    animation: otif-grow 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d) both;
  }
  :global(.is-on) .val {
    animation: otif-fade 0.4s ease calc(var(--d) + 0.6s) both;
  }
  @keyframes otif-grow {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(var(--s));
    }
  }
  @keyframes otif-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>

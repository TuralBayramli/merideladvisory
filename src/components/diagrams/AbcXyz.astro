---
// ABC-XYZ matrix: value class by demand stability, with the stock policy for each cell.
import { t, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).diagrams;
const L = d.abc;
// Shade from strongest (AX) to lightest (CZ).
const shade = (r: number, c: number) => ['s0', 's1', 's2', 's3', 's4'][r + c];
---

<figure class="figure">
  <figcaption><strong>{L.title}</strong><span>{d.example}</span></figcaption>
  <div class="matrix" role="table" aria-label={L.title}>
    <div class="corner" role="columnheader"><span>{L.value} ↓</span><span>{L.demand} →</span></div>
    {L.cols.map((c) => <div class="colh" role="columnheader">{c}</div>)}
    {
      L.rows.map((r, ri) => (
        <>
          <div class="rowh" role="rowheader">{r}</div>
          {L.cells[ri].map((cell, ci) => (
            <div class:list={['cell', shade(ri, ci)]} role="cell">
              <b>
                {r}
                {L.cols[ci].charAt(0)}
              </b>
              <span>{cell}</span>
            </div>
          ))}
        </>
      ))
    }
  </div>
</figure>

<style>
  .matrix {
    display: grid;
    grid-template-columns: 2.4rem repeat(3, 1fr);
    gap: 4px;
    font-size: 0.82rem;
    line-height: 1.3;
  }
  .corner {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    font-size: 0.68rem;
    color: var(--muted);
    grid-column: 1;
  }
  .corner span:first-child {
    display: none;
  }
  .colh {
    padding: 0.2rem 0.4rem 0.45rem;
    font-weight: 600;
    color: var(--ink);
  }
  .rowh {
    display: grid;
    place-items: center;
    font: 500 1.35rem / 1 var(--serif);
    color: var(--ink);
  }
  .cell {
    border-radius: 8px;
    padding: 0.6rem 0.6rem 0.7rem;
    min-height: 5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .cell b {
    font: 600 0.78rem / 1 var(--sans);
    letter-spacing: 0.04em;
    opacity: 0.8;
  }
  .s0 {
    background: var(--signal);
    color: #ffffff;
  }
  .s1 {
    background: #5a87ff;
    color: #ffffff;
  }
  .s2 {
    background: var(--signal-mid);
    color: var(--ink);
  }
  .s3 {
    background: #d3dfff;
    color: var(--ink);
  }
  .s4 {
    background: var(--signal-soft);
    color: var(--ink);
  }
</style>

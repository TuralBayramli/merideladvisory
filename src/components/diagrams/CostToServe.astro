---
// Two customers with the same gross margin and very different net profit.
import { t, type Lang } from '../../i18n/ui';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang).diagrams;
const L = d.cts;
const fmt = (n: number) => (n < 0 ? '−' : '') + Math.abs(n).toLocaleString('en-GB').replace(',', ' ');
const MAX = 3000;
const X0 = 104, X1 = 318;
const sx = (v: number) => X0 + (v / MAX) * (X1 - X0);
const rows = [
  { name: L.a, net: 2420, y: 52 },
  { name: L.b, net: -150, y: 150 },
];
---

<figure class="figure">
  <figcaption><strong>{L.title}</strong><span>{d.example}</span></figcaption>
  <svg class="chart" viewBox="0 0 340 224" role="img" aria-label={L.title}>
    {
      rows.map((r) => (
        <g>
          <text class="name" x="0" y={r.y + 4}>
            {r.name}
          </text>
          <rect class="margin" x={sx(0)} y={r.y - 20} width={sx(MAX) - sx(0)} height="16" rx="3" />
          <text class="small" x={sx(MAX)} y={r.y - 26} text-anchor="end">
            {L.margin} {fmt(MAX)}
          </text>
          {r.net >= 0 ? (
            <rect class="net" x={sx(0)} y={r.y + 2} width={sx(r.net) - sx(0)} height="16" rx="3" />
          ) : (
            <rect class="loss" x={sx(r.net)} y={r.y + 2} width={sx(0) - sx(r.net)} height="16" rx="3" />
          )}
          {r.net >= 0 ? (
            <text class="val in" x={sx(r.net) - 8} y={r.y + 14.5} text-anchor="end">
              {L.net} {fmt(r.net)} {L.currency}
            </text>
          ) : (
            <text class="val neg" x={sx(0) + 6} y={r.y + 14.5}>
              {L.net} {fmt(r.net)} {L.currency}
            </text>
          )}
        </g>
      ))
    }
    <line class="zero" x1={sx(0)} x2={sx(0)} y1="18" y2="196"></line>
    <g class="key" transform="translate(0 212)">
      <rect x="0" y="-9" width="12" height="10" rx="2" class="margin"></rect>
      <text x="17" y="0">{L.margin}</text>
      <rect x="132" y="-9" width="12" height="10" rx="2" class="net"></rect>
      <text x="149" y="0">{L.net}</text>
    </g>
  </svg>
</figure>

<style>
  .chart {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
    overflow: visible;
    font-family: var(--sans);
  }
  .name {
    font: 500 13px var(--sans);
    fill: var(--ink);
  }
  .small {
    font-size: 11px;
    fill: var(--muted);
  }
  .margin {
    fill: var(--mist-2);
  }
  .net {
    fill: var(--signal);
  }
  .loss {
    fill: var(--neg);
  }
  .val {
    font-size: 12.5px;
    font-weight: 600;
    fill: var(--ink);
  }
  .val.neg {
    fill: var(--neg);
  }
  .val.in {
    fill: #ffffff;
  }
  .zero {
    stroke: var(--ink);
    stroke-width: 1;
  }
  .key text {
    font-size: 11px;
    fill: var(--muted);
  }
</style>

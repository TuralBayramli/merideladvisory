---
// The Meridel Advisory logo, drawn from src/assets/brand/lockup.svg (made by brand/build_logo.py).
// Ink takes the text colour; the gold comes from --logo-gold.
import lockup from '../assets/brand/lockup.svg?raw';

interface Props {
  href: string;
  class?: string;
}
const { href, class: cls } = Astro.props;
// Each copy on a page needs its own ids for the clip and mask inside the mark.
const uid = `lg${Math.random().toString(36).slice(2, 8)}`;
const svg = lockup
  .replaceAll('LOGOID', uid)
  .replace(' role="img" aria-label="Meridel Advisory"', ' aria-hidden="true" focusable="false"')
  .replace('<svg ', '<svg class="logo-svg" ');
---

<a class:list={['logo', cls]} href={href} aria-label="Meridel Advisory, home">
  <Fragment set:html={svg} />
</a>

<style>
  .logo {
    display: inline-flex;
    color: var(--ink);
    line-height: 0;
    text-decoration: none;
  }
  .logo :global(.logo-svg) {
    height: 3.15rem;
    width: auto;
  }
  @media (max-width: 30rem) {
    .logo :global(.logo-svg) {
      height: 2.7rem;
    }
  }
</style>

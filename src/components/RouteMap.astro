---
// Animated map of the trade routes between Europe, the Caucasus, Central Asia, China and the Gulf.
// The map is projected at build time, so visitors download plain SVG, no map library.
import fs from 'node:fs';
import path from 'node:path';
import { feature, mesh } from 'topojson-client';
import { presimplify, simplify, quantile } from 'topojson-simplify';
import { geoConicConformal, geoPath } from 'd3-geo';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);

const W = 1000;
const H = 500;
const raw = JSON.parse(
  fs.readFileSync(path.join(process.cwd(), 'node_modules/world-atlas/countries-50m.json'), 'utf-8'),
);
const topo = simplify(presimplify(raw as any), quantile(presimplify(raw as any), 0.5)) as any;
const land = feature(topo, topo.objects.land);
const borders = mesh(topo, topo.objects.countries, (a: unknown, b: unknown) => a !== b);
// The area to show. Edges follow parallels and meridians (many points), because
// d3 draws polygon edges as great circles, which would bow north over this width.
const [LON0, LON1, LAT0, LAT1] = [0, 112, 19.5, 55.5];
const edge = (a: number, b: number, n: number) => Array.from({ length: n + 1 }, (_, i) => a + ((b - a) * i) / n);
const ring = [
  ...edge(LON0, LON1, 56).map((lon) => [lon, LAT0]),
  ...edge(LAT0, LAT1, 18).map((lat) => [LON1, lat]),
  ...edge(LON1, LON0, 56).map((lon) => [lon, LAT1]),
  ...edge(LAT1, LAT0, 18).map((lat) => [LON0, lat]),
];
const frame = { type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [ring.reverse()] } } as any;
const projection = geoConicConformal()
  .parallels([30, 50])
  .rotate([-56, 0])
  .fitExtent([[10, 10], [W - 10, H - 10]], frame)
  .clipExtent([[0, 0], [W, H]]);
const toPath = geoPath(projection).digits(1);
const landPath = toPath(land as any) ?? '';
const borderPath = toPath(borders as any) ?? '';

const P = (lon: number, lat: number) => projection([lon, lat]) as [number, number];

// Smooth line through points (Catmull-Rom converted to cubic Bézier).
function smooth(pts: [number, number][]): string {
  const f = (n: number) => n.toFixed(1);
  let dStr = `M${f(pts[0][0])} ${f(pts[0][1])}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const p0 = pts[i - 1] ?? pts[i];
    const p1 = pts[i];
    const p2 = pts[i + 1];
    const p3 = pts[i + 2] ?? p2;
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    dStr += ` C${f(c1[0])} ${f(c1[1])} ${f(c2[0])} ${f(c2[1])} ${f(p2[0])} ${f(p2[1])}`;
  }
  return dStr;
}

const city = {
  rotterdam: [4.48, 51.92],
  warsaw: [21.01, 52.23],
  istanbul: [28.98, 41.01],
  tbilisi: [44.79, 41.72],
  baku: [49.87, 40.41],
  aktau: [51.2, 43.65],
  almaty: [76.95, 43.25],
  xian: [108.94, 34.34],
  dubai: [55.27, 25.2],
} as const;
type CityKey = keyof typeof city;

const lanes = [
  {
    id: 'lane-middle',
    kind: 'middle',
    dur: 30,
    cargo: 5,
    // Xi'an – Urumqi – Khorgos – Almaty – Aktau – Caspian – Baku – Tbilisi – Kars – Istanbul – Balkans – Warsaw
    pts: [
      P(...city.xian), P(103.83, 36.06), P(98.29, 39.77), P(87.62, 43.83), P(80.41, 44.21), P(...city.almaty),
      P(69.6, 42.3), P(65.51, 44.85), P(55.2, 45.3), P(...city.aktau), P(...city.baku), P(46.36, 40.68),
      P(...city.tbilisi), P(43.1, 40.6), P(41.27, 39.9), P(32.86, 39.93), P(...city.istanbul), P(23.32, 42.7),
      P(20.46, 44.79), P(19.04, 47.5), P(19.0, 50.26), P(...city.warsaw),
    ],
  },
  {
    id: 'lane-europe',
    kind: 'europe',
    dur: 10,
    cargo: 2,
    pts: [P(...city.warsaw), P(16.93, 52.41), P(13.4, 52.52), P(9.73, 52.37), P(6.76, 51.43), P(...city.rotterdam)],
  },
  {
    id: 'lane-south',
    kind: 'south',
    dur: 12,
    cargo: 3,
    pts: [P(...city.baku), P(48.87, 38.43), P(49.6, 37.2), P(52.6, 32.6), P(56.27, 27.18), P(...city.dubai)],
  },
].map((l) => ({ ...l, d: smooth(l.pts as [number, number][]) }));

const home: CityKey[] = ['warsaw', 'baku'];
const minor: CityKey[] = ['istanbul', 'tbilisi', 'aktau'];
// Label placement relative to the city dot.
const place: Record<CityKey, 'n' | 's' | 'e' | 'w' | 'ne' | 'nw' | 'se' | 'sw'> = {
  rotterdam: 'w',
  warsaw: 'n',
  istanbul: 'sw',
  tbilisi: 'nw',
  baku: 'se',
  aktau: 'ne',
  almaty: 's',
  xian: 's',
  dubai: 'w',
};
const cities = (Object.keys(city) as CityKey[]).map((k) => {
  const [x, y] = P(...city[k]);
  return { key: k, x, y, left: (x / W) * 100, top: (y / H) * 100, home: home.includes(k), minor: minor.includes(k), place: place[k] };
});

const regionAt: Record<string, [number, number]> = {
  europe: [5.5, 46.6],
  turkiye: [34.5, 38.4],
  caucasus: [41.8, 44.6],
  centralAsia: [63.5, 47.2],
  china: [96, 39.4],
  gulf: [60.5, 22.2],
};
const regions = Object.entries(regionAt).map(([k, [lon, lat]]) => {
  const [x, y] = P(lon, lat);
  return { key: k, left: (x / W) * 100, top: (y / H) * 100, minor: k === 'turkiye' || k === 'caucasus' };
});
---

<figure class="routemap">
  <div class="scroller">
  <div class="stage">
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid meet">
      <path class="land" d={landPath}></path>
      <path class="borders" d={borderPath}></path>
      {
        lanes.map((l) => (
          <g class:list={['lane', `lane-${l.kind}`]}>
            <path id={l.id} class="lane-base" d={l.d} />
            <path class="lane-flow" d={l.d} />
            {Array.from({ length: l.cargo }, (_, i) => (
              <circle class="cargo" r="4.2">
                <animateMotion dur={`${l.dur}s`} begin={`-${((l.dur / l.cargo) * i).toFixed(2)}s`} repeatCount="indefinite" rotate="auto">
                  <mpath href={`#${l.id}`} />
                </animateMotion>
              </circle>
            ))}
          </g>
        ))
      }
      {
        cities.map((c) => (
          <g class:list={['city', { home: c.home }]}>
            {c.home && <circle class="pulse" cx={c.x.toFixed(1)} cy={c.y.toFixed(1)} r="16" />}
            <circle class="dot" cx={c.x.toFixed(1)} cy={c.y.toFixed(1)} r={c.home ? 6.5 : 4.5} />
          </g>
        ))
      }
    </svg>
    {
      regions.map((r) => (
        <span class:list={['region', { minor: r.minor }]} style={`left:${r.left.toFixed(2)}%;top:${r.top.toFixed(2)}%`}>
          {d.home.regions[r.key]}
        </span>
      ))
    }
    {
      cities.map((c) => (
        <span class:list={['label', `p-${c.place}`, { home: c.home, minor: c.minor }]} style={`left:${c.left.toFixed(2)}%;top:${c.top.toFixed(2)}%`}>
          {d.home.cities[c.key]}
        </span>
      ))
    }
  </div>
  </div>
  <figcaption>
    <ul class="legend">
      <li class="lg-middle">{d.home.lanes.middle}</li>
      <li class="lg-south">{d.home.lanes.south}</li>
      <li class="lg-europe">{d.home.lanes.europe}</li>
    </ul>
  </figcaption>
</figure>

<script>
  // Respect reduced-motion preferences and pause animation when the map is off screen.
  const svgs = document.querySelectorAll<SVGSVGElement>('.routemap svg');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  svgs.forEach((svg) => {
    if (reduce.matches) {
      svg.pauseAnimations();
      return;
    }
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) svg.unpauseAnimations();
        else svg.pauseAnimations();
      });
      io.observe(svg);
    }
  });
</script>

<style>
  .routemap {
    margin: 0;
  }
  .stage {
    position: relative;
    aspect-ratio: 1000 / 500;
  }
  .stage svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .land {
    fill: #dfe6f0;
  }
  .borders {
    fill: none;
    stroke: #ffffff;
    stroke-width: 0.8;
    vector-effect: non-scaling-stroke;
  }
  .lane-base {
    fill: none;
    stroke-width: 2.2;
    vector-effect: non-scaling-stroke;
    opacity: 0.3;
  }
  .lane-flow {
    fill: none;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-dasharray: 1 10;
    vector-effect: non-scaling-stroke;
    animation: flow 1.6s linear infinite;
  }
  .lane-middle .lane-base,
  .lane-middle .lane-flow {
    stroke: var(--signal);
  }
  .lane-south .lane-base,
  .lane-south .lane-flow {
    stroke: var(--gold);
  }
  .lane-europe .lane-base,
  .lane-europe .lane-flow {
    stroke: var(--ink);
  }
  .cargo {
    fill: #ffffff;
    stroke-width: 1.8;
  }
  .lane-middle .cargo {
    stroke: var(--signal);
  }
  .lane-south .cargo {
    stroke: var(--gold);
  }
  .lane-europe .cargo {
    stroke: var(--ink);
  }
  .city .dot {
    fill: var(--ink);
    stroke: #ffffff;
    stroke-width: 1.6;
  }
  .city.home .dot {
    fill: var(--gold);
    stroke: #ffffff;
    stroke-width: 2;
  }
  .pulse {
    fill: none;
    stroke: var(--gold);
    stroke-width: 1.4;
    transform-box: fill-box;
    transform-origin: center;
    animation: pulse 2.8s ease-out infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -11;
    }
  }
  @keyframes pulse {
    0% {
      opacity: 0.9;
      transform: scale(0.35);
    }
    100% {
      opacity: 0;
      transform: scale(1.4);
    }
  }

  .region {
    position: absolute;
    transform: translate(-50%, -50%);
    font: italic 400 clamp(0.8rem, 0.55rem + 0.9vw, 1.3rem) / 1 var(--serif);
    color: #7a879f;
    white-space: nowrap;
    pointer-events: none;
  }
  .label {
    position: absolute;
    font-size: clamp(0.66rem, 0.5rem + 0.5vw, 0.92rem);
    line-height: 1;
    color: var(--ink-2);
    white-space: nowrap;
    pointer-events: none;
    text-shadow: 0 0 3px #f1f4f8, 0 0 3px #f1f4f8;
  }
  .label.home {
    color: var(--ink);
    font-weight: 600;
  }
  .p-e {
    transform: translate(0.9em, -50%);
  }
  .p-w {
    transform: translate(calc(-100% - 0.9em), -50%);
  }
  .p-n {
    transform: translate(-50%, calc(-100% - 0.85em));
  }
  .p-s {
    transform: translate(-50%, 0.85em);
  }
  .p-ne {
    transform: translate(0.6em, calc(-100% - 0.5em));
  }
  .p-nw {
    transform: translate(calc(-100% - 0.6em), calc(-100% - 0.5em));
  }
  .p-se {
    transform: translate(0.7em, 0.55em);
  }
  .p-sw {
    transform: translate(calc(-100% - 0.6em), 0.5em);
  }
  /* On phones the map keeps a readable size and scrolls sideways. */
  @media (max-width: 40rem) {
    .scroller {
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: thin;
    }
    .stage {
      width: 46rem;
    }
    .label {
      font-size: 0.78rem;
    }
    .region {
      font-size: 1rem;
    }
  }

  .legend {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    color: var(--ink-2);
    font-size: 0.925rem;
  }
  .legend li {
    position: relative;
    padding-left: 1.8rem;
  }
  .legend li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.66em;
    width: 1.25rem;
    border-top: 3px dotted;
  }
  .lg-middle::before {
    border-color: var(--signal);
  }
  .lg-south::before {
    border-color: var(--gold);
  }
  .lg-europe::before {
    border-color: var(--ink);
  }
</style>

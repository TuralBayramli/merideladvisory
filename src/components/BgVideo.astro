---
// Muted, looping background video with a pause button.
// Plays only while on screen, and never starts on its own for visitors
// who prefer reduced motion. Files live in public/videos/:
//   <name>.mp4 (desktop), <name>-720.mp4 (phones, optional), <name>.jpg (still frame, optional)
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  name: string;
  pauseLabel: string;
  playLabel: string;
  /** Load straight away (hero) instead of when scrolled into view. */
  eager?: boolean;
}
const { name, pauseLabel, playLabel, eager = false } = Astro.props;
const dir = path.join(process.cwd(), 'public', 'videos');
const has = (f: string) => fs.existsSync(path.join(dir, f));
const mobile = has(`${name}-720.mp4`);
const poster = has(`${name}.jpg`) ? `/videos/${name}.jpg` : undefined;
---

<div class="bgv">
  <video class="bgv-video" muted loop playsinline preload={eager ? 'auto' : 'none'} poster={poster} aria-hidden="true" tabindex="-1">
    {mobile && <source src={`/videos/${name}-720.mp4`} type="video/mp4" media="(max-width: 48rem)" />}
    <source src={`/videos/${name}.mp4`} type="video/mp4" />
  </video>
  <button class="bgv-toggle" type="button" aria-label={pauseLabel} data-pause={pauseLabel} data-play={playLabel}>
    <svg class="i-pause" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4h3v12H6zM11 4h3v12h-3z" fill="currentColor"></path></svg>
    <svg class="i-play" viewBox="0 0 20 20" aria-hidden="true"><path d="M6 4l10 6-10 6z" fill="currentColor"></path></svg>
  </button>
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('.bgv').forEach((wrap) => {
    const video = wrap.querySelector('video');
    const button = wrap.querySelector<HTMLButtonElement>('.bgv-toggle');
    if (!video || !button) return;
    let userPaused = reduce;
    let visible = false;
    const show = (playing: boolean) => {
      button.classList.toggle('paused', !playing);
      button.setAttribute('aria-label', (playing ? button.dataset.pause : button.dataset.play) ?? '');
    };
    const update = () => {
      if (visible && !userPaused) {
        video.play().then(() => show(true)).catch(() => show(false));
      } else {
        video.pause();
        show(!userPaused);
      }
    };
    show(!userPaused);
    new IntersectionObserver(
      ([entry]) => {
        visible = entry.isIntersecting;
        update();
      },
      { threshold: 0.15 },
    ).observe(wrap);
    button.addEventListener('click', () => {
      userPaused = !userPaused;
      update();
    });
  });
</script>

<style>
  /* The parent section sets position: relative and puts its content above (z-index: 1). */
  .bgv {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .bgv-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--deep);
  }
  .bgv::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(14, 23, 41, 0.78) 0%, rgba(14, 23, 41, 0.5) 42%, rgba(14, 23, 41, 0.08) 100%),
      linear-gradient(0deg, rgba(14, 23, 41, 0.4), transparent 38%);
    pointer-events: none;
  }
  .bgv-toggle {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: 1.25rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.45);
    background: rgba(14, 23, 41, 0.45);
    color: #ffffff;
    cursor: pointer;
  }
  .bgv-toggle:hover {
    background: rgba(14, 23, 41, 0.7);
  }
  .bgv-toggle svg {
    width: 1rem;
    height: 1rem;
  }
  .bgv-toggle .i-play,
  .bgv-toggle.paused .i-pause {
    display: none;
  }
  .bgv-toggle.paused .i-play {
    display: block;
  }
  @media (max-width: 40rem) {
    .bgv::after {
      background: linear-gradient(0deg, rgba(14, 23, 41, 0.78), rgba(14, 23, 41, 0.58));
    }
  }
</style>

---
// A globe drawn with meridians and parallels. One meridian is highlighted,
// with a position fix on it and a course line leaving it: the Meridel story.
const R = 260;
const C = 300;
const rad = (deg: number) => (deg * Math.PI) / 180;
const meridians = [15, 30, 45, 60, 75].map((deg) => +(R * Math.sin(rad(deg))).toFixed(1));
const parallels = [15, 30, 45, 60, 75].flatMap((deg) => {
  const dy = R * Math.sin(rad(deg));
  const hw = R * Math.cos(rad(deg));
  return [
    { y: +(C - dy).toFixed(1), x1: +(C - hw).toFixed(1), x2: +(C + hw).toFixed(1) },
    { y: +(C + dy).toFixed(1), x1: +(C - hw).toFixed(1), x2: +(C + hw).toFixed(1) },
  ];
});
const rx = +(R * Math.sin(rad(40))).toFixed(1);
const fixX = +(C + rx * Math.cos(rad(35))).toFixed(1);
const fixY = +(C - R * Math.sin(rad(35))).toFixed(1);
---

<svg class="graticule" viewBox="0 0 680 600" aria-hidden="true" focusable="false">
  <g class="grid">
    <circle cx={C} cy={C} r={R}></circle>
    <line x1={C} y1={C - R} x2={C} y2={C + R}></line>
    <line x1={C - R} y1={C} x2={C + R} y2={C} class="equator"></line>
    {meridians.map((m) => <ellipse cx={C} cy={C} rx={m} ry={R} />)}
    {parallels.map((p) => <line x1={p.x1} y1={p.y} x2={p.x2} y2={p.y} />)}
  </g>
  <path class="meridian" pathLength="100" d={`M${C} ${C - R} A${rx} ${R} 0 0 1 ${C} ${C + R}`}></path>
  <line class="course" x1={fixX} y1={fixY} x2={fixX + 170} y2={fixY - 120}></line>
  <g class="fix">
    <circle cx={fixX} cy={fixY} r="15" class="ring"></circle>
    <circle cx={fixX} cy={fixY} r="5.5" class="dot"></circle>
  </g>
</svg>

<style>
  .graticule {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .grid circle,
  .grid ellipse,
  .grid line {
    fill: none;
    stroke: var(--deep-line);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .grid circle {
    stroke: rgba(220, 230, 248, 0.32);
  }
  .grid .equator {
    stroke: rgba(220, 230, 248, 0.28);
  }
  .meridian {
    fill: none;
    stroke: var(--madder-bright);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 0;
    vector-effect: non-scaling-stroke;
  }
  .course {
    stroke: var(--madder-bright);
    stroke-width: 1.5;
    stroke-dasharray: 2 7;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }
  .ring {
    fill: none;
    stroke: var(--madder-bright);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
  }
  .dot {
    fill: var(--madder-bright);
  }

  @media (prefers-reduced-motion: no-preference) {
    .meridian {
      animation: draw 1.6s cubic-bezier(0.6, 0, 0.2, 1) 0.2s both;
    }
    .fix {
      animation: appear 0.5s ease-out 1.5s both;
      transform-box: fill-box;
      transform-origin: center;
    }
    .course {
      animation: fade 0.8s ease-out 1.9s both;
    }
  }
  @keyframes draw {
    from {
      stroke-dashoffset: 100;
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>

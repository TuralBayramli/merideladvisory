---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { t, localePath, type Lang, EMAIL, LINKEDIN } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Language-neutral path of this page, e.g. "/services". */
  path: string;
  /** Whether the same page exists in the other language. */
  hasAlternate?: boolean;
  type?: 'website' | 'article';
}

const { lang, title, description, path, hasAlternate = true, type = 'website' } = Astro.props;
const d = t(lang);
const other: Lang = lang === 'en' ? 'az' : 'en';
const site = Astro.site ?? new URL('https://merideladvisory.com');
const canonical = new URL(localePath(lang, path), site).href;
const altHref = hasAlternate ? localePath(other, path) : localePath(other, '/');
const year = new Date().getFullYear();
const servicesHref = localePath(lang, '/services');

const links = [
  { key: 'services', href: servicesHref, label: d.nav.services },
  { key: 'insights', href: localePath(lang, '/insights'), label: d.nav.insights },
  { key: 'about', href: localePath(lang, '/about'), label: d.nav.about },
  { key: 'contact', href: localePath(lang, '/contact'), label: d.nav.contact },
];
const isActive = (key: string) => path.startsWith(`/${key}`);
---

<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      hasAlternate && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(localePath('en', path), site).href} />
          <link rel="alternate" hreflang="az" href={new URL(localePath('az', path), site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), site).href} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Meridel Advisory" />
    <meta property="og:locale" content={d.locale.replace('-', '_')} />
    <meta property="og:image" content={new URL('/og.png', site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">{d.skip}</a>

    <header class="site-header">
      <div class="bar">
        <button class="menu-btn" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="site-menu" data-open-menu>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18M3 12h18M3 17.5h18" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"></path></svg>
          <span class="menu-label">{d.nav.menu}</span>
        </button>

        <Logo href={localePath(lang, '/')} class="bar-logo" />

        <div class="bar-actions">
          <a class="lang" href={altHref} hreflang={other} lang={other} title={d.switchLabel}>
            <span aria-hidden="true">{d.switchShort}</span>
            <span class="visually-hidden">{d.switchLabel}</span>
          </a>
          <a class="btn btn-solid btn-sm bar-cta" href={localePath(lang, '/contact')}>{d.nav.bookCall}</a>
        </div>
      </div>
    </header>

    <dialog id="site-menu" class="drawer" aria-label={d.nav.menu}>
      <div class="drawer-inner">
        <div class="drawer-top">
          <button class="menu-btn" type="button" data-close-menu>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"></path></svg>
            <span class="menu-label">{d.nav.close}</span>
          </button>
        </div>
        <nav aria-label={d.nav.menu}>
          <ul class="drawer-main">
            {
              links.map((l) => (
                <li>
                  <a href={l.href} aria-current={isActive(l.key) ? 'page' : undefined}>
                    {l.label}
                  </a>
                  {l.key === 'services' && (
                    <ul class="drawer-sub">
                      {d.services.map((s) => (
                        <li>
                          <a href={`${servicesHref}#${s.id}`}>{s.title}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="drawer-foot">
          <a class="btn btn-solid" href={localePath(lang, '/contact')}>{d.nav.bookCall}</a>
          <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
          <p><a href={altHref} hreflang={other} lang={other}>{d.switchLabel}</a></p>
        </div>
      </div>
    </dialog>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <Logo href={localePath(lang, '/')} />
          <p>{d.footer.tagline}</p>
        </div>
        <div class="foot-col">
          <h2>{d.nav.services}</h2>
          <ul>
            {
              d.services.map((s) => (
                <li>
                  <a href={`${servicesHref}#${s.id}`}>{s.title}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="foot-col">
          <h2>{d.nav.company}</h2>
          <ul>
            {
              links
                .filter((l) => l.key !== 'services')
                .map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))
            }
            <li>
              <a href={altHref} hreflang={other} lang={other}>{d.switchLabel}</a>
            </li>
          </ul>
        </div>
        <div class="foot-col">
          <h2>{d.nav.contact}</h2>
          <ul>
            <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
            <li><a href={LINKEDIN} rel="noopener">LinkedIn</a></li>
            <li class="plain">{d.contact.location}</li>
          </ul>
        </div>
        <p class="copy">© {year} Meridel Advisory. {d.footer.rights}</p>
      </div>
    </footer>

    <script>
      // Left-hand menu: a modal dialog, so focus stays inside and Escape closes it.
      const dialog = document.getElementById('site-menu') as HTMLDialogElement | null;
      const openers = document.querySelectorAll<HTMLButtonElement>('[data-open-menu]');
      if (dialog) {
        openers.forEach((btn) =>
          btn.addEventListener('click', () => {
            dialog.showModal();
            btn.setAttribute('aria-expanded', 'true');
          }),
        );
        dialog.querySelectorAll('[data-close-menu]').forEach((b) => b.addEventListener('click', () => dialog.close()));
        // A click on the dimmed backdrop lands on the dialog itself, outside its content.
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) dialog.close();
        });
        dialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));
        dialog.addEventListener('close', () => openers.forEach((b) => b.setAttribute('aria-expanded', 'false')));
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
    padding-inline: var(--gutter);
  }
  .menu-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 0.35rem;
    margin-left: -0.35rem;
    background: none;
    border: 0;
    color: var(--ink);
    font: 500 0.975rem / 1 var(--sans);
    cursor: pointer;
  }
  .menu-btn svg {
    width: 1.55rem;
    height: 1.55rem;
  }
  .menu-btn:hover {
    color: var(--signal-ink);
  }
  .bar-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .lang {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 1.2rem;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .lang:hover {
    border-color: var(--ink);
  }
  @media (max-width: 44rem) {
    .menu-label,
    .bar-cta {
      display: none;
    }
  }

  .drawer {
    margin: 0;
    inset: 0 auto 0 0;
    width: min(26rem, 100vw);
    height: 100dvh;
    max-height: none;
    max-width: 100vw;
    padding: 0;
    border: 0;
    background: var(--paper);
    color: var(--ink);
    box-shadow: 24px 0 60px -30px rgba(10, 18, 32, 0.45);
  }
  .drawer[open] {
    animation: slide-in 260ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .drawer::backdrop {
    background: rgba(10, 18, 32, 0.42);
  }
  @keyframes slide-in {
    from {
      transform: translateX(-100%);
    }
  }
  .drawer-inner {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    padding: 0 clamp(1.25rem, 1rem + 1.5vw, 2rem) 2rem;
  }
  .drawer-top {
    display: flex;
    align-items: center;
    min-height: 4.5rem;
  }
  .drawer-top .menu-label {
    display: inline;
  }
  .drawer ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .drawer-main {
    border-top: 1px solid var(--line);
  }
  .drawer-main > li {
    border-bottom: 1px solid var(--line);
    padding-block: 0.4rem;
  }
  .drawer-main > li > a {
    display: block;
    padding: 0.65rem 0;
    font: 440 1.7rem / 1.15 var(--serif);
    color: var(--ink);
    text-decoration: none;
  }
  .drawer-main > li > a:hover,
  .drawer-main > li > a[aria-current='page'] {
    color: var(--signal-ink);
  }
  .drawer-sub {
    padding: 0 0 0.75rem !important;
  }
  .drawer-sub a {
    display: block;
    padding: 0.32rem 0 0.32rem 1rem;
    border-left: 2px solid var(--line);
    color: var(--ink-2);
    text-decoration: none;
    font-size: 0.975rem;
  }
  .drawer-sub a:hover {
    border-left-color: var(--signal);
    color: var(--signal-ink);
  }
  .drawer-foot {
    margin-top: auto;
    padding-top: 2rem;
  }
  .drawer-foot p {
    margin: 1rem 0 0;
  }

  .site-footer {
    background: var(--mist);
    padding-block: 4rem 2.5rem;
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .foot {
    display: grid;
    grid-template-columns: 1.4fr 1.2fr 0.9fr 1.1fr;
    gap: 2.5rem 2.5rem;
  }
  .foot-brand p {
    margin: 1.25rem 0 0;
    max-width: 18rem;
    color: var(--muted);
  }
  .foot-col h2 {
    font: 600 0.9rem / 1.3 var(--sans);
    letter-spacing: 0;
    color: var(--ink);
    margin-bottom: 0.9rem;
  }
  .foot-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .foot-col a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .foot-col a:hover {
    color: var(--signal-ink);
    text-decoration: underline;
  }
  .foot-col .plain {
    color: var(--muted);
  }
  .copy {
    grid-column: 1 / -1;
    margin: 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.875rem;
  }
  @media (max-width: 56rem) {
    .foot {
      grid-template-columns: 1fr 1fr;
    }
    .foot-brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 34rem) {
    .foot {
      grid-template-columns: 1fr;
    }
  }
</style>

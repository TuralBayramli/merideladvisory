---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import SearchDialog from '../components/SearchDialog.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { t, localePath, type Lang, EMAIL, SOCIAL } from '../i18n/ui';
import { x } from '../i18n/extra';
import { TOPICS, topic, topicPath } from '../i18n/topics';
import { getArticles } from '../i18n/insights';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Language-neutral path of this page, e.g. "/services". */
  path: string;
  /** Whether the same page exists in the other language. */
  hasAlternate?: boolean;
  type?: 'website' | 'article';
  /** Share image for this page, e.g. "/og/en/cost-to-serve.png". */
  ogImage?: string;
  /** Extra structured data for search engines. */
  jsonLd?: object[];
}

const { lang, title, description, path, hasAlternate = true, type = 'website', ogImage = '/og.png', jsonLd = [] } = Astro.props;
const d = t(lang);
const X = x(lang);
const other: Lang = lang === 'en' ? 'az' : 'en';
const site = Astro.site ?? new URL('https://merideladvisory.com');
const canonical = new URL(localePath(lang, path), site).href;
const altHref = hasAlternate ? localePath(other, path) : localePath(other, '/');
const year = new Date().getFullYear();
const servicesHref = localePath(lang, '/services');
const insightsHref = localePath(lang, '/insights');
const aboutHref = localePath(lang, '/about');
const contactHref = localePath(lang, '/contact');
const termsHref = localePath(lang, '/insights/terms');
const toolsHref = localePath(lang, '/insights/tools');

const links = [
  { key: 'services', href: servicesHref, label: d.nav.services },
  { key: 'insights', href: insightsHref, label: d.nav.insights },
  { key: 'about', href: aboutHref, label: d.nav.about },
  { key: 'contact', href: contactHref, label: d.nav.contact },
];
const isActive = (key: string) => path.startsWith(`/${key}`);

const articles = await getArticles(lang);
const latest = articles.slice(0, 2);
const topics = TOPICS.map((id) => ({
  id,
  name: topic(lang, id).name,
  href: localePath(lang, topicPath(id)),
  count: articles.filter((a) => a.data.topic === id).length,
})).filter((tp) => tp.count > 0);
const chevron = 'M4 6.5l4 4 4-4';

const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.origin}/#organization`,
  name: 'Meridel Advisory',
  url: site.origin + '/',
  logo: new URL('/brand/meridel-profile-1080.png', site).href,
  email: EMAIL,
  sameAs: SOCIAL.map((s) => s.href),
  description: d.home.description,
  areaServed: ['Europe', 'Caucasus', 'Central Asia', 'China'],
  address: [
    { '@type': 'PostalAddress', addressLocality: 'Warsaw', addressCountry: 'PL' },
    { '@type': 'PostalAddress', addressLocality: 'Baku', addressCountry: 'AZ' },
  ],
  knowsLanguage: ['en', 'az'],
};
const ld = [org, ...jsonLd];
---

<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      hasAlternate && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(localePath('en', path), site).href} />
          <link rel="alternate" hreflang="az" href={new URL(localePath('az', path), site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), site).href} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title={X.rss.title} href={localePath(lang, '/rss.xml')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#14213a" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Meridel Advisory" />
    <meta property="og:locale" content={d.locale.replace('-', '_')} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {ld.map((o) => <script type="application/ld+json" set:html={JSON.stringify(o)} />)}
  </head>
  <body>
    <a class="skip" href="#main">{d.skip}</a>

    <header class="site-header navy">
      <div class="bar">
        <button
          class="menu-btn"
          type="button"
          aria-haspopup="dialog"
          aria-expanded="false"
          aria-controls="site-menu"
          aria-label={d.nav.menu}
          data-open-menu
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6.5h18M3 12h18M3 17.5h18" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"></path></svg>
          <span class="menu-label" aria-hidden="true">{d.nav.menu}</span>
        </button>

        <Logo href={localePath(lang, '/')} class="bar-logo" />

        <nav class="top-nav" aria-label={d.nav.main}>
          <ul class="tn">
            <li class="tn-item" data-mega>
              <a class="tn-link" href={servicesHref} aria-current={isActive('services') ? 'page' : undefined}>{d.nav.services}</a>
              <button class="tn-toggle" type="button" aria-expanded="false" aria-controls="mega-services">
                <span class="visually-hidden">{X.menu.toggle} {d.nav.services}</span>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d={chevron}></path></svg>
              </button>
              <div class="mega light" id="mega-services" hidden>
                <div class="wrap mega-inner">
                  <div class="mega-intro">
                    <p class="mega-title">{d.nav.services}</p>
                    <p>{X.menu.servicesText}</p>
                    <a class="mega-more" href={servicesHref}>{X.menu.allServices}</a>
                  </div>
                  <ul class="mega-grid">
                    {
                      d.services.map((s) => (
                        <li>
                          <a href={`${servicesHref}#${s.id}`}>
                            <strong>{s.title}</strong>
                            <span>{X.menu.blurbs[s.id]}</span>
                          </a>
                        </li>
                      ))
                    }
                    <li>
                      <a href={`${servicesHref}#workshops`}>
                        <strong>{X.menu.workshops}</strong>
                        <span>{X.menu.workshopsText}</span>
                      </a>
                    </li>
                  </ul>
                </div>
              </div>
            </li>

            <li class="tn-item" data-mega>
              <a class="tn-link" href={insightsHref} aria-current={isActive('insights') ? 'page' : undefined}>{d.nav.insights}</a>
              <button class="tn-toggle" type="button" aria-expanded="false" aria-controls="mega-insights">
                <span class="visually-hidden">{X.menu.toggle} {d.nav.insights}</span>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d={chevron}></path></svg>
              </button>
              <div class="mega light" id="mega-insights" hidden>
                <div class="wrap mega-inner mega-insights">
                  <div class="mega-intro">
                    <p class="mega-title">{d.nav.insights}</p>
                    <p>{X.menu.insightsText}</p>
                    <a class="mega-more" href={insightsHref}>{X.menu.allInsights}</a>
                  </div>
                  <div>
                    <p class="mega-label">{X.menu.topics}</p>
                    <ul class="mega-list">
                      {
                        topics.map((tp) => (
                          <li>
                            <a href={tp.href}>
                              {tp.name}
                              <span class="count">{tp.count}</span>
                            </a>
                          </li>
                        ))
                      }
                    </ul>
                    <p class="mega-label">{X.menu.resources}</p>
                    <ul class="mega-list">
                      <li><a href={termsHref}>{X.hub.termsTitle}</a></li>
                      <li><a href={toolsHref}>{X.hub.toolsTitle}</a></li>
                    </ul>
                  </div>
                  <div>
                    <p class="mega-label">{X.menu.latest}</p>
                    <ul class="mega-latest">
                      {
                        latest.map((a) => (
                          <li>
                            <a href={localePath(lang, `/insights/${a.slug}`)}>
                              <img src={`/images/${a.data.image}-wide-800.webp`} width="800" height="533" alt="" loading="lazy" decoding="async" />
                              <span>{a.data.title}</span>
                            </a>
                          </li>
                        ))
                      }
                    </ul>
                  </div>
                </div>
              </div>
            </li>

            <li class="tn-item" data-mega>
              <a class="tn-link" href={aboutHref} aria-current={isActive('about') ? 'page' : undefined}>{d.nav.about}</a>
              <button class="tn-toggle" type="button" aria-expanded="false" aria-controls="mega-about">
                <span class="visually-hidden">{X.menu.toggle} {d.nav.about}</span>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d={chevron}></path></svg>
              </button>
              <div class="mega light" id="mega-about" hidden>
                <div class="wrap mega-inner mega-about">
                  <div class="mega-intro">
                    <p class="mega-title">{d.nav.about}</p>
                    <p>{X.menu.aboutText}</p>
                  </div>
                  <ul class="mega-list big">
                    {
                      X.menu.aboutLinks.map((l) => (
                        <li>
                          <a href={`${aboutHref}${l.hash}`}>{l.label}</a>
                        </li>
                      ))
                    }
                  </ul>
                  <div class="mega-cta navy">
                    <p>{d.cta.title}</p>
                    <a class="btn btn-solid btn-sm" href={contactHref}>{d.nav.bookCall}</a>
                    <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
                  </div>
                </div>
              </div>
            </li>

            <li class="tn-item">
              <a class="tn-link" href={contactHref} aria-current={isActive('contact') ? 'page' : undefined}>{d.nav.contact}</a>
            </li>
          </ul>
        </nav>

        <div class="bar-actions">
          <button class="icon-btn" type="button" data-open-search aria-label={X.search.open}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5l5 5"></path></svg>
          </button>
          <a class="lang" href={altHref} hreflang={other} lang={other} title={d.switchLabel}>
            <span aria-hidden="true">{d.switchShort}</span>
            <span class="visually-hidden">{d.switchLabel}</span>
          </a>
          <a class="btn btn-solid btn-sm bar-cta" href={contactHref}>{d.nav.bookCall}</a>
        </div>
      </div>
      <div class="mega-scrim" aria-hidden="true"></div>
    </header>

    <dialog id="site-menu" class="drawer" aria-label={d.nav.menu}>
      <div class="drawer-inner">
        <div class="drawer-top">
          <button class="menu-btn" type="button" data-close-menu>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5.5 5.5l13 13M18.5 5.5l-13 13" stroke="currentColor" stroke-width="1.7" fill="none" stroke-linecap="round"></path></svg>
            <span class="menu-label">{d.nav.close}</span>
          </button>
        </div>
        <nav aria-label={d.nav.menu}>
          <ul class="drawer-main">
            {
              links.map((l) => (
                <li>
                  <a href={l.href} aria-current={isActive(l.key) ? 'page' : undefined}>
                    {l.label}
                  </a>
                  {l.key === 'services' && (
                    <ul class="drawer-sub">
                      {d.services.map((s) => (
                        <li>
                          <a href={`${servicesHref}#${s.id}`}>{s.title}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                  {l.key === 'insights' && (
                    <ul class="drawer-sub">
                      {topics.map((tp) => (
                        <li>
                          <a href={tp.href}>{tp.name}</a>
                        </li>
                      ))}
                      <li>
                        <a href={termsHref}>{X.hub.termsTitle}</a>
                      </li>
                      <li>
                        <a href={toolsHref}>{X.hub.toolsTitle}</a>
                      </li>
                    </ul>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="drawer-foot">
          <a class="btn btn-solid" href={contactHref}>{d.nav.bookCall}</a>
          <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
          <ul class="social drawer-social">
            {
              SOCIAL.map((s) => (
                <li>
                  <a href={s.href} rel="noopener" target="_blank">
                    {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
          <p><a href={altHref} hreflang={other} lang={other}>{d.switchLabel}</a></p>
        </div>
      </div>
    </dialog>

    <SearchDialog lang={lang} />

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer navy">
      <div class="wrap foot">
        <div class="foot-brand">
          <Logo href={localePath(lang, '/')} />
          <p>{d.footer.tagline}</p>
          <p class="follow-title">{X.social.title}</p>
          <ul class="social">
            {
              SOCIAL.map((s) => (
                <li>
                  <a href={s.href} rel="noopener me" target="_blank">
                    {s.name}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="foot-col">
          <h2>{d.nav.services}</h2>
          <ul>
            {
              d.services.map((s) => (
                <li>
                  <a href={`${servicesHref}#${s.id}`}>{s.title}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="foot-col">
          <h2>{d.nav.insights}</h2>
          <ul>
            {
              topics.map((tp) => (
                <li>
                  <a href={tp.href}>{tp.name}</a>
                </li>
              ))
            }
            <li><a href={termsHref}>{X.hub.termsTitle}</a></li>
            <li><a href={toolsHref}>{X.hub.toolsTitle}</a></li>
          </ul>
        </div>
        <div class="foot-col">
          <h2>{d.nav.company}</h2>
          <ul>
            <li><a href={aboutHref}>{d.nav.about}</a></li>
            <li><a href={contactHref}>{d.nav.contact}</a></li>
            <li>
              <a href={altHref} hreflang={other} lang={other}>{d.switchLabel}</a>
            </li>
          </ul>
        </div>
        <div class="foot-col">
          <h2>{d.nav.contact}</h2>
          <ul>
            <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
            <li class="plain">{d.contact.location}</li>
          </ul>
        </div>
        <p class="copy">© {year} Meridel Advisory. {d.footer.rights}</p>
      </div>
    </footer>

    <ChatWidget lang={lang} />

    <script>
      // Left-hand menu: a modal dialog, so focus stays inside and Escape closes it.
      const dialog = document.getElementById('site-menu') as HTMLDialogElement | null;
      const openers = document.querySelectorAll<HTMLButtonElement>('[data-open-menu]');
      if (dialog) {
        openers.forEach((btn) =>
          btn.addEventListener('click', () => {
            dialog.showModal();
            btn.setAttribute('aria-expanded', 'true');
          }),
        );
        dialog.querySelectorAll('[data-close-menu]').forEach((b) => b.addEventListener('click', () => dialog.close()));
        // A click on the dimmed backdrop lands on the dialog itself, outside its content.
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) dialog.close();
        });
        dialog.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dialog.close()));
        dialog.addEventListener('close', () => openers.forEach((b) => b.setAttribute('aria-expanded', 'false')));
      }

      // Top menu panels: open on hover, or with the small arrow button by keyboard and touch.
      const items = [...document.querySelectorAll<HTMLElement>('[data-mega]')];
      const root = document.documentElement;
      let current: HTMLElement | null = null;
      let timer = 0;
      const parts = (item: HTMLElement) => ({
        panel: item.querySelector<HTMLElement>('.mega')!,
        toggle: item.querySelector<HTMLButtonElement>('.tn-toggle')!,
      });
      const close = (item: HTMLElement) => {
        const { panel, toggle } = parts(item);
        item.classList.remove('open');
        panel.hidden = true;
        toggle.setAttribute('aria-expanded', 'false');
        if (current === item) current = null;
        if (!current) root.classList.remove('mega-on');
      };
      const open = (item: HTMLElement) => {
        if (current && current !== item) close(current);
        const { panel, toggle } = parts(item);
        item.classList.add('open');
        panel.hidden = false;
        toggle.setAttribute('aria-expanded', 'true');
        current = item;
        root.classList.add('mega-on');
      };
      const hoverable = window.matchMedia('(hover: hover) and (pointer: fine)');
      items.forEach((item) => {
        const { toggle } = parts(item);
        item.addEventListener('mouseenter', () => {
          if (!hoverable.matches) return;
          window.clearTimeout(timer);
          timer = window.setTimeout(() => open(item), current ? 0 : 110);
        });
        item.addEventListener('mouseleave', () => {
          if (!hoverable.matches) return;
          window.clearTimeout(timer);
          timer = window.setTimeout(() => close(item), 180);
        });
        toggle.addEventListener('click', () => (item.classList.contains('open') ? close(item) : open(item)));
        item.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && item.classList.contains('open')) {
            close(item);
            toggle.focus();
          }
        });
        item.addEventListener('focusout', (e) => {
          if (!item.contains(e.relatedTarget as Node | null)) close(item);
        });
      });
      document.addEventListener('click', (e) => {
        if (current && !current.contains(e.target as Node)) close(current);
      });
    </script>
  </body>
</html>

<style>
  /* Navy bar, so the logo shows in its ivory and gold colours. */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(20, 33, 58, 0.97);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(194, 165, 116, 0.3);
  }
  .site-header :global(.bar-logo) {
    color: var(--ivory);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    min-height: 4.5rem;
    padding-inline: var(--gutter);
  }
  .menu-btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 0.35rem;
    margin-left: -0.35rem;
    background: none;
    border: 0;
    color: var(--ink);
    font: 500 0.975rem / 1 var(--sans);
    cursor: pointer;
  }
  .menu-btn svg {
    width: 1.55rem;
    height: 1.55rem;
  }
  .menu-btn:hover {
    color: var(--gold);
  }
  .bar-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }
  .icon-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--gold);
  }
  .icon-btn svg {
    width: 1.3rem;
    height: 1.3rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .lang {
    display: inline-grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 1.2rem;
    color: var(--ink);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .lang:hover {
    border-color: var(--gold);
    color: var(--gold);
  }
  @media (max-width: 44rem) {
    .menu-label,
    .bar-cta {
      display: none;
    }
    .bar-actions {
      gap: 0.35rem;
    }
  }

  /* Main links in the bar on wide screens, each with a panel of sub-pages. */
  .top-nav {
    display: none;
  }
  .tn {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.1rem;
    height: 100%;
  }
  .tn-item {
    display: flex;
    align-items: center;
  }
  .tn-link {
    position: relative;
    display: block;
    padding: 0.65rem 0.2rem 0.65rem 0.8rem;
    color: var(--ink);
    font-size: 0.975rem;
    font-weight: 500;
    text-decoration: none;
  }
  .tn-item:not([data-mega]) .tn-link {
    padding-right: 0.8rem;
  }
  .tn-link::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.2rem;
    bottom: 0.2rem;
    height: 2px;
    border-radius: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 180ms ease;
  }
  .tn-item:not([data-mega]) .tn-link::after {
    right: 0.8rem;
  }
  .tn-link:hover,
  .tn-item.open .tn-link {
    color: var(--gold);
  }
  .tn-link:hover::after,
  .tn-item.open .tn-link::after,
  .tn-link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .tn-toggle {
    display: inline-grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    margin-right: 0.35rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--muted);
    cursor: pointer;
  }
  .tn-toggle:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--ink);
  }
  .tn-toggle svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms ease;
  }
  .tn-item.open .tn-toggle svg {
    transform: rotate(180deg);
  }
  @media (min-width: 68rem) {
    .bar {
      grid-template-columns: auto auto 1fr auto;
      column-gap: 1.4rem;
    }
    .menu-label {
      display: none;
    }
    .top-nav {
      display: block;
      align-self: stretch;
      margin-left: 1rem;
    }
  }

  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 2;
    background: var(--paper);
    border-top: 1px solid var(--line);
    box-shadow: 0 24px 48px -24px rgba(10, 18, 32, 0.28);
    animation: mega-in 180ms ease-out;
  }
  .mega[hidden] {
    display: none;
  }
  @keyframes mega-in {

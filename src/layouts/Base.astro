---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import { t, localePath, type Lang, EMAIL } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Language-neutral path of this page, e.g. "/services". */
  path: string;
  /** Whether the same page exists in the other language. */
  hasAlternate?: boolean;
  type?: 'website' | 'article';
}

const { lang, title, description, path, hasAlternate = true, type = 'website' } = Astro.props;
const d = t(lang);
const other: Lang = lang === 'en' ? 'az' : 'en';
const site = Astro.site ?? new URL('https://merideladvisory.com');
const canonical = new URL(localePath(lang, path), site).href;
const altHref = hasAlternate ? localePath(other, path) : localePath(other, '/');
const year = new Date().getFullYear();

const links = [
  { key: 'services', href: localePath(lang, '/services'), label: d.nav.services },
  { key: 'insights', href: localePath(lang, '/insights'), label: d.nav.insights },
  { key: 'about', href: localePath(lang, '/about'), label: d.nav.about },
  { key: 'contact', href: localePath(lang, '/contact'), label: d.nav.contact },
];
const isActive = (key: string) => path.startsWith(`/${key}`);
---

<!doctype html>
<html lang={d.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {
      hasAlternate && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(localePath('en', path), site).href} />
          <link rel="alternate" hreflang="az" href={new URL(localePath('az', path), site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL(localePath('en', path), site).href} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#14213a" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Meridel Advisory" />
    <meta property="og:locale" content={d.locale.replace('-', '_')} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    <a class="skip" href="#main">{d.skip}</a>

    <header class="site-header">
      <div class="wrap bar">
        <Logo href={localePath(lang, '/')} />

        <nav class="nav-desktop" aria-label={d.nav.menu}>
          <ul>
            {
              links.map((l) => (
                <li>
                  <a href={l.href} aria-current={isActive(l.key) ? 'page' : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="lang" href={altHref} hreflang={other} lang={other} title={d.switchLabel}>
            <span aria-hidden="true">{d.switchShort}</span>
            <span class="visually-hidden">{d.switchLabel}</span>
          </a>
        </nav>

        <details class="nav-mobile">
          <summary>
            <span>{d.nav.menu}</span>
            <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.6" fill="none"></path></svg>
          </summary>
          <nav aria-label={d.nav.menu}>
            <ul>
              {
                links.map((l) => (
                  <li>
                    <a href={l.href} aria-current={isActive(l.key) ? 'page' : undefined}>
                      {l.label}
                    </a>
                  </li>
                ))
              }
              <li>
                <a href={altHref} hreflang={other} lang={other}>{d.switchLabel}</a>
              </li>
            </ul>
          </nav>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <Logo href={localePath(lang, '/')} />
          <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
        </div>
        <ul class="foot-links">
          {
            links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
          <li>
            <a href={altHref} hreflang={other} lang={other}>{d.switchLabel}</a>
          </li>
        </ul>
        <p class="legal">{d.footer.legal}</p>
        <p class="copy">© {year} Meridel Advisory. {d.footer.rights}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
  }
  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-desktop ul,
  .nav-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-desktop ul {
    display: flex;
    gap: 1.75rem;
  }
  .nav-desktop a,
  .nav-mobile a {
    color: var(--ink);
    text-decoration: none;
    font-size: 0.975rem;
  }
  .nav-desktop ul a {
    padding-block: 0.4rem;
    border-bottom: 1.5px solid transparent;
  }
  .nav-desktop ul a:hover {
    border-bottom-color: var(--rule);
  }
  .nav-desktop a[aria-current='page'] {
    border-bottom-color: var(--madder);
  }
  .lang {
    display: inline-grid;
    place-items: center;
    min-width: 2.6rem;
    height: 2rem;
    border: 1px solid var(--rule);
    border-radius: 1rem;
    font-size: 0.85rem !important;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .lang:hover {
    border-color: var(--ink);
  }

  .nav-mobile {
    display: none;
    position: relative;
  }
  .nav-mobile summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    cursor: pointer;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    font-size: 0.975rem;
  }
  .nav-mobile summary::-webkit-details-marker {
    display: none;
  }
  .nav-mobile summary svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .nav-mobile nav {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    min-width: 14rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    padding: 0.5rem;
    box-shadow: 0 12px 32px -12px rgba(15, 25, 45, 0.28);
  }
  .nav-mobile li a {
    display: block;
    padding: 0.75rem 0.9rem;
    border-radius: 0.5rem;
  }
  .nav-mobile li a:hover,
  .nav-mobile li a[aria-current='page'] {
    background: color-mix(in srgb, var(--ink) 6%, transparent);
  }
  .nav-mobile li:last-child {
    border-top: 1px solid var(--rule);
    margin-top: 0.4rem;
    padding-top: 0.4rem;
  }

  @media (max-width: 52rem) {
    .nav-desktop {
      display: none;
    }
    .nav-mobile {
      display: block;
    }
  }

  .site-footer {
    background: var(--surface);
    border-top: 1px solid var(--rule);
    padding-block: 3.5rem 2.5rem;
    font-size: 0.925rem;
    color: var(--slate);
  }
  .foot {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem 3rem;
  }
  .foot-brand :global(.logo) {
    color: var(--ink);
  }
  .foot-brand p {
    margin: 1rem 0 0;
  }
  .foot-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, auto);
    gap: 0.6rem 2.5rem;
    align-content: start;
  }
  .foot-links a {
    color: var(--ink);
    text-decoration: none;
  }
  .foot-links a:hover {
    text-decoration: underline;
  }
  .legal {
    grid-column: 1 / -1;
    max-width: 46rem;
    margin: 0;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  .copy {
    grid-column: 1 / -1;
    margin: 0;
  }
  @media (max-width: 40rem) {
    .foot {
      grid-template-columns: 1fr;
    }
  }
</style>

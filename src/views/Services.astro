---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const s = d.services;
---

<Base lang={lang} title={s.title} description={s.description} path="/services">
  <header class="page-head">
    <div class="wrap">
      <h1>{s.h1}</h1>
      <p>{s.lead}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      {
        d.practices.map((p, i) => (
          <article class="service">
            <div class="service-intro">
              <h2>{p.title}</h2>
              <p>{p.text}</p>
            </div>
            <div class="service-detail">
              <div>
                <h3>{d.home.questionsLabel}</h3>
                <ul>
                  {p.questions.map((q) => (
                    <li>{q}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h3>{s.deliverablesLabel}</h3>
                <ul>
                  {s.deliverables[i].map((x) => (
                    <li>{x}</li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section engagements">
    <div class="wrap two-col">
      <div>
        <h2>{d.home.engagementsTitle}</h2>
        <p class="muted">{d.home.engagementsLead}</p>
      </div>
      <ul class="eng-list">
        {
          d.engagements.map((e) => (
            <li>
              <div class="eng-top">
                <h3>{e.title}</h3>
                <span>{e.length}</span>
              </div>
              <p>{e.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <h2>{s.pricingTitle}</h2>
      <p class="pricing">{s.pricingText}</p>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .service {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 2rem 4rem;
    padding-block: 2.75rem;
    border-top: 1px solid var(--rule);
  }
  .service:first-child {
    border-top-color: var(--ink);
  }
  .service h2 {
    font-size: var(--step-2);
    font-weight: 460;
  }
  .service-intro p {
    margin: 1rem 0 0;
    color: var(--slate);
    max-width: 30rem;
  }
  .service-detail {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .service-detail h3 {
    font: 600 0.95rem / 1.3 var(--sans);
    letter-spacing: 0;
    margin-bottom: 0.75rem;
  }
  .service-detail ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
  }
  .service-detail li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--rule);
  }
  @media (max-width: 56rem) {
    .service {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 34rem) {
    .service-detail {
      grid-template-columns: 1fr;
    }
  }

  .engagements {
    background: var(--surface);
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 2rem 4rem;
  }
  .muted {
    color: var(--slate);
    margin-top: 1rem;
    max-width: 26rem;
  }
  .eng-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .eng-list li {
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
  }
  .eng-list li:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .eng-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .eng-top span {
    font-size: 0.875rem;
    color: var(--slate);
  }
  .eng-list p {
    margin: 0.5rem 0 0;
    color: var(--slate);
  }
  .pricing {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 36rem;
    margin: 0;
  }
  @media (max-width: 56rem) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
</style>

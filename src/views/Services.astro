---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Diagram from '../components/diagrams/Diagram.astro';
import { t, tools, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const s = d.servicesPage;
---

<Base lang={lang} title={s.title} description={s.description} path="/services">
  <header class="page-head">
    <div class="wrap">
      <h1>{s.h1}</h1>
      <p>{s.lead}</p>
      <nav class="jump" aria-label={s.h1}>
        <ul>
          {
            d.services.map((x) => (
              <li>
                <a href={`#${x.id}`}>{x.tab}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </header>

  <div class="photo-band">
    <img
      src="/images/rail-wide-1600.webp"
      srcset="/images/rail-wide-800.webp 800w, /images/rail-wide-1600.webp 1600w"
      sizes="100vw"
      width="1600"
      height="1067"
      alt=""
      decoding="async"
    />
  </div>

  <section class="section independent">
    <div class="wrap two-col">
      <h2>{s.independentTitle}</h2>
      <p class="lead-serif">{s.independentText}</p>
    </div>
  </section>

  {
    d.services.map((x, i) => (
      <section class:list={['section', 'service', { tint: i % 2 === 0, flip: i % 2 === 1 }]} id={x.id}>
        <div class="wrap service-grid">
          <div class="service-text">
            <span class="rule-gold" />
            <h2>{x.title}</h2>
            <p class="service-lead">{x.text}</p>
            <div class="lists">
              <div>
                <h3>{d.questionsLabel}</h3>
                <ul>
                  {x.questions.map((q) => (
                    <li>{q}</li>
                  ))}
                </ul>
              </div>
              <div>
                <h3>{d.deliverablesLabel}</h3>
                <ul class="deliv">
                  {x.deliverables.map((q) => (
                    <li>{q}</li>
                  ))}
                </ul>
              </div>
            </div>
            {x.id === 'data' && (
              <ul class="chips tool-chips">
                {tools.slice(0, 9).map((tool) => (
                  <li>{tool}</li>
                ))}
              </ul>
            )}
          </div>
          <div class="service-fig">
            <Diagram lang={lang} id={x.id} />
          </div>
        </div>
      </section>
    ))
  }

  <section class="section workshops" id="workshops">
    <div class="wrap workshop-grid">
      <img
        src="/images/workshop-wide-800.webp"
        srcset="/images/workshop-wide-800.webp 800w, /images/workshop-wide-1600.webp 1600w"
        sizes="(max-width: 52rem) 100vw, 45vw"
        width="800"
        height="533"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <div>
        <span class="rule-gold"></span>
        <h2>{s.workshopsTitle}</h2>
        <p class="service-lead">{s.workshopsText}</p>
        <ul class="topics">
          {s.workshopTopics.map((w) => <li>{w}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <h2 class="eng-title">{d.home.engagementsTitle}</h2>
      <p class="eng-lead">{d.home.engagementsLead}</p>
      <ul class="eng-list">
        {
          d.engagements.map((e) => (
            <li>
              <div class="eng-top">
                <h3>{e.title}</h3>
                <span>{e.length}</span>
              </div>
              <p>{e.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap two-col">
      <h2>{s.pricingTitle}</h2>
      <p class="lead-serif">{s.pricingText}</p>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .jump ul {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .jump a {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    background: var(--paper);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.925rem;
    font-weight: 500;
  }
  .jump a:hover {
    background: var(--signal);
    border-color: var(--signal);
    color: #ffffff;
  }
  .photo-band img {
    width: 100%;
    height: clamp(13rem, 32vw, 26rem);
    object-fit: cover;
    object-position: 60% 55%;
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 1.5rem 4rem;
    align-items: start;
  }
  .lead-serif {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.5;
    margin: 0;
    max-width: 40rem;
  }
  @media (max-width: 52rem) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }

  .service-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: center;
  }
  .flip .service-text {
    order: 2;
  }
  .service-text h2 {
    font-size: var(--step-3);
  }
  .service-lead {
    margin: 1rem 0 1.75rem;
    font-size: 1.1rem;
    color: var(--ink-2);
    max-width: 36rem;
  }
  .lists {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem 2rem;
  }
  .lists h3 {
    font: 600 0.9rem / 1.3 var(--sans);
    margin-bottom: 0.6rem;
  }
  .lists ul {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.95rem;
  }
  .lists li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }
  .deliv li {
    position: relative;
    padding-left: 1.4rem;
  }
  .deliv li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 1rem;
    width: 0.55rem;
    height: 0.3rem;
    border-left: 1.6px solid var(--signal);
    border-bottom: 1.6px solid var(--signal);
    transform: rotate(-45deg);
  }
  .tool-chips {
    margin-top: 1.75rem;
  }
  @media (max-width: 56rem) {
    .service-grid {
      grid-template-columns: 1fr;
    }
    .flip .service-text {
      order: 0;
    }
  }
  @media (max-width: 34rem) {
    .lists {
      grid-template-columns: 1fr;
    }
  }

  .workshop-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: center;
  }
  .workshop-grid img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .workshop-grid h2 {
    font-size: var(--step-3);
  }
  .topics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .topics li {
    padding: 0.75rem 1rem;
    border-radius: 10px;
    background: var(--signal-soft);
    color: var(--ink);
    font-weight: 500;
  }
  @media (max-width: 52rem) {
    .workshop-grid {
      grid-template-columns: 1fr;
    }
  }

  .eng-lead {
    color: var(--muted);
    margin: 1rem 0 2rem;
    max-width: 36rem;
  }
  .eng-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .eng-list li {
    background: var(--paper);
    border-radius: var(--radius);
    padding: 1.4rem 1.5rem;
    border-left: 3px solid var(--gold);
  }
  .eng-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .eng-top h3 {
    font-size: 1.25rem;
    font-weight: 500;
  }
  .eng-top span {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--signal-ink);
  }
  .eng-list p {
    margin: 0.5rem 0 0;
    color: var(--muted);
  }
  @media (max-width: 48rem) {
    .eng-list {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { t, EMAIL, LINKEDIN, SOCIAL, type Lang } from '../i18n/ui';
import { x } from '../i18n/extra';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
const S = x(lang).social;
---

<Base lang={lang} title={c.title} description={c.description} path="/contact">
  <header class="page-head">
    <div class="wrap">
      <h1>{c.h1}</h1>
      <p>{c.lead}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap contact-grid">
      <div class="email-block">
        <h2>{c.emailLabel}</h2>
        <a class="email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
        <p class="li"><a href={LINKEDIN} rel="noopener">{c.linkedinLabel}</a></p>
      </div>
      <div class="side">
        <h2>{c.whatTitle}</h2>
        <ul>
          {c.what.map((w) => <li>{w}</li>)}
        </ul>
        <h2>{c.locationTitle}</h2>
        <p>{c.location}</p>
        <h2 class="follow">{S.title}</h2>
        <p>{S.text}</p>
        <ul class="social">
          {
            SOCIAL.map((s) => (
              <li>
                <a href={s.href} rel="noopener" target="_blank">
                  {s.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem 5rem;
    align-items: start;
  }
  .email-block h2,
  .side h2 {
    font: 600 0.95rem / 1.3 var(--sans);
    letter-spacing: 0;
    margin-bottom: 0.9rem;
  }
  .email {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1rem + 2.4vw, 2.6rem);
    color: var(--ink);
    text-decoration-color: var(--gold);
    text-decoration-thickness: 1.5px;
    overflow-wrap: anywhere;
  }
  .email:hover {
    text-decoration-thickness: 3px;
  }
  .li {
    margin: 1.5rem 0 0;
  }
  .side {
    border-top: 1px solid var(--ink);
    padding-top: 1.25rem;
  }
  .side ul {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }
  .side li {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.95rem;
  }
  .side p {
    color: var(--slate);
    margin: 0;
  }
  .follow {
    margin-top: 2rem;
  }
  .social {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    display: flex;
    gap: 0.5rem;
  }
  .social a {
    display: inline-block;
    padding: 0.45rem 1rem;
    border: 1px solid var(--line);
    border-radius: 2rem;
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
  }
  .social a:hover {
    border-color: var(--gold);
    color: var(--gold-ink);
  }
  @media (max-width: 52rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

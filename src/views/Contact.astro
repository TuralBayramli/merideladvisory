---
import Base from '../layouts/Base.astro';
import { t, EMAIL, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const c = d.contact;
---

<Base lang={lang} title={c.title} description={c.description} path="/contact">
  <header class="page-head">
    <div class="wrap">
      <h1>{c.h1}</h1>
      <p>{c.lead}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap contact-grid">
      <div class="email-block">
        <h2>{c.emailLabel}</h2>
        <a class="email" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      </div>
      <div class="side">
        <h2>{c.whatTitle}</h2>
        <ul>
          {c.what.map((w) => <li>{w}</li>)}
        </ul>
        <h2>{c.locationTitle}</h2>
        <p>{c.location}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 3rem 5rem;
    align-items: start;
  }
  .email-block h2,
  .side h2 {
    font: 600 0.95rem / 1.3 var(--sans);
    letter-spacing: 0;
    margin-bottom: 0.9rem;
  }
  .email {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 1rem + 2.4vw, 2.6rem);
    color: var(--ink);
    text-decoration-color: var(--madder);
    text-decoration-thickness: 1.5px;
    overflow-wrap: anywhere;
  }
  .email:hover {
    text-decoration-thickness: 3px;
  }
  .side {
    border-top: 1px solid var(--ink);
    padding-top: 1.25rem;
  }
  .side ul {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }
  .side li {
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--rule);
    font-size: 0.95rem;
  }
  .side p {
    color: var(--slate);
    margin: 0;
  }
  @media (max-width: 52rem) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

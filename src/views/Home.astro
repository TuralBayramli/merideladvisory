---
import Base from '../layouts/Base.astro';
import fs from 'node:fs';
import path from 'node:path';
import RouteMap from '../components/RouteMap.astro';
import BgVideo from '../components/BgVideo.astro';
import CtaBand from '../components/CtaBand.astro';
import ModeCards from '../components/ModeCards.astro';
import ServiceTabs from '../components/ServiceTabs.astro';
import DashboardMock from '../components/diagrams/DashboardMock.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { t, localePath, tools, type Lang } from '../i18n/ui';
import { getArticles } from '../i18n/insights';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const latest = (await getArticles(lang)).slice(0, 3);

// Background videos switch on automatically when their files exist in public/videos/.
const videoDir = path.join(process.cwd(), 'public', 'videos');
const heroVideo = fs.existsSync(path.join(videoDir, 'hero.mp4'));
const bandVideo = fs.existsSync(path.join(videoDir, 'band.mp4'));
---

<Base lang={lang} title={d.home.title} description={d.home.description} path="/">
  <section class:list={['hero', 'on-deep', { 'has-video': heroVideo }]}>
    {heroVideo && <BgVideo name="hero" eager pauseLabel={d.home.videoPause} playLabel={d.home.videoPlay} />}
    <div class="wrap hero-inner">
      <h1>{d.home.h1.split(/(?<=\.)\s+/).map((line) => <span class="h1-line">{line}</span>)}</h1>
      <p class="hero-lead">{d.home.lead}</p>
      <div class="hero-actions">
        <a class="btn btn-solid" href={localePath(lang, '/contact')}>{d.home.ctaPrimary}</a>
        <a class="btn btn-line" href={localePath(lang, '/services')}>{d.home.ctaSecondary}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="advise">
        <h2>{d.home.adviseTitle}</h2>
        <p>{d.home.adviseText}</p>
      </div>
      <ModeCards lang={lang} />
    </div>
  </section>

  <section class="section tint" id="services">
    <div class="wrap">
      <div class="section-head">
        <h2>{d.home.servicesTitle}</h2>
        <p>{d.home.servicesLead}</p>
      </div>
      <ServiceTabs lang={lang} />
    </div>
  </section>

  <section class="section map-section navy">
    <div class="wrap">
      <div class="section-head">
        <h2>{d.home.mapTitle}</h2>
        <p>{d.home.mapLead}</p>
      </div>
      <RouteMap lang={lang} tone="navy" />
    </div>
  </section>

  <section class="section tint">
    <div class="wrap data-grid">
      <div class="data-text">
        <h2>{d.home.dataTitle}</h2>
        <p class="data-lead">{d.home.dataText}</p>
        <ul class="points">
          {d.home.dataPoints.map((p) => <li>{p}</li>)}
        </ul>
        <h3 class="tools-label">{d.home.toolsLabel}</h3>
        <ul class="chips">
          {tools.slice(0, 9).map((x) => <li>{x}</li>)}
        </ul>
      </div>
      <div class="data-visual">
        <img
          class="data-photo"
          src="/images/data-wide-800.webp"
          srcset="/images/data-wide-800.webp 800w, /images/data-wide-1600.webp 1600w"
          sizes="(max-width: 56rem) 100vw, 46vw"
          width="800"
          height="533"
          alt=""
          loading="lazy"
          decoding="async"
        />
        <div class="data-dash">
          <DashboardMock lang={lang} />
        </div>
      </div>
    </div>
    <div class="wrap workshop">
      <img
        src="/images/workshop-wide-800.webp"
        srcset="/images/workshop-wide-800.webp 800w, /images/workshop-wide-1600.webp 1600w"
        sizes="(max-width: 56rem) 100vw, 40vw"
        width="800"
        height="533"
        alt=""
        loading="lazy"
        decoding="async"
      />
      <div>
        <h3>{d.home.workshopTitle}</h3>
        <p>{d.home.workshopText}</p>
        <a href={`${localePath(lang, '/services')}#workshops`}>{d.home.servicesMore}</a>
      </div>
    </div>
  </section>

  <section class="section approach">
    <div class="wrap">
      <div class="section-head">
        <h2>{d.home.approachTitle}</h2>
        <p>{d.home.approachLead}</p>
      </div>
      <ol class="steps">
        {
          d.steps.map((s, i) => (
            <li class="step">
              <span class="step-n" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <div class="section-head">
        <h2>{d.home.engagementsTitle}</h2>
        <p>{d.home.engagementsLead}</p>
      </div>
      <div class="eng-grid">
        {
          d.engagements.map((e) => (
            <div class="eng">
              <span class="eng-len">{e.length}</span>
              <h3>{e.title}</h3>
              <p>{e.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    latest.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="insights-head">
            <h2>{d.home.insightsTitle}</h2>
            <a href={localePath(lang, '/insights')}>{d.home.insightsAll}</a>
          </div>
          <div class="article-list">
            {latest.map((a) => (
              <ArticleCard article={a} lang={lang} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section tint founder">
    <div class="wrap founder-inner">
      <h2>{d.home.founderTitle}</h2>
      <div>
        <p class="founder-text">{d.home.founderText}</p>
        <a href={localePath(lang, '/about')}>{d.home.founderMore}</a>
      </div>
    </div>
  </section>

  {
    bandVideo ? (
      <section class="band on-deep">
        <BgVideo name="band" pauseLabel={d.home.videoPause} playLabel={d.home.videoPlay} />
        <div class="wrap band-inner">
          <p class="band-text">{d.home.bandText}</p>
          <div class="band-cta">
            <p>{d.home.bandCta}</p>
            <a class="btn btn-solid" href={localePath(lang, '/contact')}>
              {d.cta.button}
            </a>
          </div>
        </div>
      </section>
    ) : (
      <CtaBand lang={lang} />
    )
  }
</Base>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--navy);
    color: #ffffff;
    padding-block: clamp(4.5rem, 3rem + 7vw, 9rem) clamp(4rem, 3rem + 5vw, 7.5rem);
    isolation: isolate;
  }
  .hero-inner {
    position: relative;
  }
  .hero.has-video {
    min-height: min(44rem, 86vh);
    display: flex;
    align-items: center;
  }
  .hero.has-video .hero-inner {
    width: min(100% - 2 * var(--gutter), var(--wrap));
    z-index: 1;
  }
  .hero h1 {
    max-width: 30ch;
    font-size: clamp(2.3rem, 1.5rem + 3.2vw, 4rem);
    color: #ffffff;
    text-shadow: 0 2px 24px rgba(8, 14, 28, 0.35);
  }
  /* The slogan is two sentences: each starts on its own line. */
  .h1-line {
    display: block;
    text-wrap: balance;
  }
  .hero-lead {
    max-width: 36rem;
    margin: 1.75rem 0 2.25rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: #e6ecf6;
    text-shadow: 0 1px 14px rgba(8, 14, 28, 0.45);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .advise {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 1.5rem clamp(2rem, 1rem + 4vw, 5rem);
    align-items: end;
    margin-bottom: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem);
  }
  .advise h2 {
    max-width: 20ch;
  }
  .advise p {
    margin: 0;
    color: var(--ink-2);
    font-size: 1.1rem;
    max-width: 34rem;
  }
  @media (max-width: 52rem) {
    .advise {
      grid-template-columns: 1fr;
    }
  }

  .data-grid {
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
    align-items: center;
  }
  .data-lead {
    margin: 1rem 0 1.5rem;
    font-size: 1.1rem;
    color: var(--ink-2);
  }
  .points {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }
  .points li {
    position: relative;
    padding: 0.75rem 0 0.75rem 1.6rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0.1rem;
    top: 1.25rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 2px;
    background: var(--signal);
  }
  .tools-label {
    font: 600 0.9rem / 1.3 var(--sans);
    margin-bottom: 0.75rem;
  }
  .data-visual {
    position: relative;
    padding-bottom: 4rem;
  }
  .data-photo {
    width: 85%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .data-dash {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(62%, 25rem);
    box-shadow: 0 24px 50px -24px rgba(20, 33, 58, 0.4);
    border-radius: var(--radius);
  }
  @media (max-width: 56rem) {
    .data-grid {
      grid-template-columns: 1fr;
    }
    .data-visual {
      padding-bottom: 0;
    }
    .data-photo {
      width: 100%;
    }
    .data-dash {
      position: relative;
      width: auto;
      margin: -3rem 0.75rem 0;
    }
  }
  .workshop {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(1.5rem, 1rem + 3vw, 4rem);
    align-items: center;
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    padding-top: clamp(3rem, 2rem + 3vw, 5rem);
    border-top: 1px solid var(--line);
  }
  .workshop img {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .workshop h3 {
    font-size: var(--step-2);
    font-weight: 440;
  }
  .workshop p {
    margin: 0.9rem 0 1rem;
    color: var(--ink-2);
    max-width: 34rem;
  }
  @media (max-width: 52rem) {
    .workshop {
      grid-template-columns: 1fr;
    }
  }

  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
    position: relative;
  }
  .steps::before {
    content: '';
    position: absolute;
    top: 1.375rem;
    left: 1.375rem;
    right: 1.375rem;
    height: 1px;
    background: var(--line);
  }
  .step {
    position: relative;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--paper);
    border: 1.5px solid var(--gold);
    color: var(--gold-ink);
    font: 500 1.2rem / 1 var(--serif);
    margin-bottom: 1.5rem;
    position: relative;
  }
  .step:last-child .step-n {
    background: var(--signal);
    border-color: var(--signal);
    color: #ffffff;
  }
  .step h3 {
    font-size: var(--step-2);
    font-weight: 440;
    margin-bottom: 0.75rem;
  }
  .step p {
    color: var(--muted);
    max-width: 22rem;
  }
  @media (max-width: 52rem) {
    .steps {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-left: 3.75rem;
    }
    .steps::before {
      display: none;
    }
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      left: -2.4rem;
      top: 2.3rem;
      bottom: -2.35rem;
      width: 1px;
      background: var(--line);
    }
    .step-n {
      position: absolute;
      left: -3.75rem;
      top: -0.4rem;
      margin: 0;
    }
  }

  .eng-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .eng {
    background: var(--paper);
    border-radius: var(--radius);
    padding: 1.6rem 1.5rem 1.75rem;
    border-top: 3px solid var(--gold);
  }
  .eng-len {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--signal-ink);
    background: var(--signal-soft);
    border-radius: 2rem;
    padding: 0.2rem 0.65rem;
    margin-bottom: 0.9rem;
  }
  .eng h3 {
    font-size: 1.3rem;
    font-weight: 500;
  }
  .eng p {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.975rem;
  }
  @media (max-width: 60rem) {
    .eng-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 40rem) {
    .eng-grid {
      grid-template-columns: 1fr;
    }
  }

  .insights-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .article-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 52rem) {
    .article-list {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }
  }

  .founder-inner {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) 1.6fr;
    gap: 1.5rem 3rem;
  }
  .founder-text {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 38rem;
  }
  @media (max-width: 44rem) {
    .founder-inner {
      grid-template-columns: 1fr;
    }
  }

  .band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--navy);
    color: #ffffff;
    min-height: clamp(22rem, 50vw, 34rem);
    display: flex;
    align-items: center;
  }
  .band-inner {
    position: relative;
    z-index: 1;
    padding-block: 4rem;
  }
  .band-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }
  .band-cta p {
    margin: 0;
    color: #e6ecf6;
    font-size: var(--step-1);
  }
  .band-text {
    margin: 0;
    max-width: 24ch;
    font-family: var(--serif);
    font-size: var(--step-3);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
</style>

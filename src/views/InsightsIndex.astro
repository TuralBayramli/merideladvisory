---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { t, type Lang } from '../i18n/ui';
import { getArticles } from '../i18n/insights';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const [first, ...rest] = await getArticles(lang);
---

<Base lang={lang} title={d.insights.title} description={d.insights.description} path="/insights">
  <header class="page-head">
    <div class="wrap">
      <h1>{d.insights.h1}</h1>
      <p>{d.insights.lead}</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      {
        first && (
          <div class="featured">
            <ArticleCard article={first} lang={lang} level={2} layout="wide" />
          </div>
        )
      }
      {
        rest.length > 0 && (
          <div class="grid">
            {rest.map((a) => (
              <ArticleCard article={a} lang={lang} level={2} />
            ))}
          </div>
        )
      }
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .featured {
    padding-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-bottom: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2.5rem;
  }
  @media (max-width: 44rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
